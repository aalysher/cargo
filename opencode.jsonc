{
  "$schema": "https://opencode.ai/config.json",
  // MCP-серверы проекта
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  // Встроенные LSP (gopls для .go, typescript для web/) — OpenCode скачает их автоматически
  "lsp": true
}
