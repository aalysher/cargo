# Скопируйте в .env: cp .env.example .env

APP_PORT=8080
APP_ENV=dev

# Postgres (docker compose поднимает с этими же кредами)
DATABASE_URL=postgres://cargo:cargo@localhost:5432/cargo?sslmode=disable

# Токен бота из @BotFather (без него worker не отправляет уведомления)
BOT_TOKEN=
BOT_USERNAME=cargo_demo_bot

# Секрет для подписи JWT — заменить в prod
JWT_SECRET=dev-secret-change-me

# Максимальный возраст initData при проверке (сек). 0 — не проверять (dev)
INIT_DATA_MAX_AGE_SECONDS=0
